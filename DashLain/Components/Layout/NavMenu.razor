@using System.Globalization
@using DashLain.Constants
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<DashLain.Resources.Components.Layout.NavMenu> Localizer

<nav class="border-b border-gray-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 justify-between">
            <div class="flex">
                <div class="flex shrink-0 items-center">
                </div>
                <div class="hidden sm:-my-px sm:ml-6 sm:flex sm:space-x-8">
                    @foreach (var link in _navLinks)
                    {
                        <a href="@link.Href"
                           class="@GetLinkClasses(link.Href)">
                            @Localizer[link.Text]
                        </a>
                    }
                </div>
            </div>
            <div class="-mr-2 flex items-center sm:hidden">
                <!-- Mobile menu button -->
                <button type="button"
                        class="relative inline-flex items-center justify-center rounded-md bg-white p-2 text-gray-400 hover:bg-gray-100 hover:text-gray-500 focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 focus:outline-hidden"
                        aria-controls="mobile-menu" aria-expanded="false">
                    <span class="absolute -inset-0.5"></span>
                    <span class="sr-only">Open main menu</span>
                    <!-- Menu open: "hidden", Menu closed: "block" -->
                    <svg class="block size-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                         aria-hidden="true" data-slot="icon">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                    </svg>
                    <!-- Menu open: "block", Menu closed: "hidden" -->
                    <svg class="hidden size-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                         aria-hidden="true" data-slot="icon">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
            <div class="flex justify-end items-center p-4">
                <select class="border rounded-md px-2 py-1 text-sm text-gray-700"
                        @onchange="OnLanguageChange">
                    @foreach (var culture in SupportedCultures.GetSupportedCultures())
                    {
                        <option value="@culture.TwoLetterLanguageName" selected="@IsSelected(culture.TwoLetterLanguageName)">
                            @culture.DisplayName
                        </option>
                    }
                </select>
            </div>
        </div>
    </div>

    <!-- Mobile menu, show/hide based on menu state. -->
    <div class="sm:hidden" id="mobile-menu">
        <div class="space-y-1 pt-2 pb-3">
            @foreach (var link in _navLinks)
            {
                <a href="@link.Href"
                   class="inline-flex items-center px-3 py-2 rounded-md text-base font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-100 transition-colors w-full sm:w-auto">
                    @Localizer[link.Text]
                </a>
            }
        </div>
    </div>
</nav>

@code {

    private static readonly (string Text, string Href)[] _navLinks = [
      ("Home", "/"), ("Profile Create", "/profile/create")
    ];

    private Task OnLanguageChange(ChangeEventArgs e)
    {
        var selected = e.Value?.ToString() ?? "en";
        Preferences.Set("lang", selected);

        // Force reload of app or main page
        var culture = new CultureInfo(selected);
        CultureInfo.DefaultThreadCurrentCulture = culture;
        CultureInfo.DefaultThreadCurrentUICulture = culture;

        // Reload to reflect localization
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
        return Task.CompletedTask;
    }

    private bool IsSelected(string value) =>
      CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == new CultureInfo(value).TwoLetterISOLanguageName;

    private string GetLinkClasses(string href)
    {
        var isActive = Navigation.Uri.EndsWith(href, StringComparison.OrdinalIgnoreCase);
        return isActive
          ? "inline-flex items-center justify-center px-3 py-1.5 rounded-md text-sm font-medium text-indigo-700 bg-indigo-100"
          : "inline-flex items-center justify-center px-3 py-1.5 rounded-md text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-100 transition-colors";
    }

    private void SetActive(string text)
    {
        Navigation.NavigateTo(_navLinks.FirstOrDefault(link => link.Text == text).Href ?? "/");
    }
}
